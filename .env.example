# API Gateway base URL from training-api `cdk deploy` (ApiUrl), no trailing slash.
# Leave empty to run on built-in mock data (seed/plans.json from training-api).
VITE_API_URL=

# Cognito hosted-UI domain (CognitoDomain output) and the web app client id (UserPoolClientId).
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=

# Optional: skip the hosted UI and go straight to one provider. "SignInWithApple"
# only works when training-api was deployed with the APPLE_* variables.
VITE_COGNITO_IDP=
