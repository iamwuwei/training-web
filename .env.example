# Lambda Function URLs from `cdk deploy` in training-api (no trailing slash).
# Leave both empty to run on built-in mock data (seed/plans.json from training-api).
VITE_API_URL=
VITE_AUTH_URL=

# Sign in with Apple Services ID (same value as training-api APPLE_CLIENT_ID).
VITE_APPLE_CLIENT_ID=

# Dev only: a session token to use instead of Apple login (Apple's JS SDK
# refuses localhost). Never set this in Cloudflare Pages.
VITE_DEV_TOKEN=
